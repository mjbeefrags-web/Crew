# Local development only. Replace every secret before using a shared environment.
# Use letters and numbers in database credentials so the DATABASE_URL stays valid.
WEB_PORT=8080
# 127.0.0.1 keeps the site private to this laptop. Set to 0.0.0.0 to let
# clients on the same Wi-Fi/LAN open http://<your-lan-ip>:8080.
WEB_HOST=127.0.0.1
VITE_INITIAL_ROUTE=/

# Feature flags (baked into the web build).
VITE_FEATURE_RECENTLY_VIEWED=true
VITE_FEATURE_COMMAND_PALETTE=true
VITE_FEATURE_AMBIENT_SOUND=true
VITE_FEATURE_WORLD_WALK=true

# Base URL of the API backend. Override when deploying to Vercel:
#   Set to https://your-app.onrender.com in production.
VITE_API_BASE_URL=http://localhost:8000

APP_NAME=Crewww API
APP_ENV=docker
DEBUG=false
POSTGRES_DB=crewww
POSTGRES_USER=crewww
POSTGRES_PASSWORD=local-only-change-me-123456
# Host port for connecting psql/pgAdmin/DBeaver to the Docker database.
# 5433 avoids a conflict with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433
# Optional: point the API at an existing PostgreSQL server instead of the
# bundled `db` service. Keep the asyncpg driver and URL-encode the password.
# DATABASE_URL=postgresql+asyncpg://crewww:password@postgres.internal:5432/crewww
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_SLOW_QUERY_MS=250
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
REDIS_MAXMEMORY=256mb
JWT_SECRET=local-compose-secret-change-this-before-any-shared-environment-123456
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
PAYMENT_MODE=mock
EMAIL_MODE=console
# Local RAG advisor needs no keys. Set openai + endpoint/key to use an
# OpenAI-compatible model; leave the key empty in committed files.
AI_PROVIDER=local
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Database connection pool (per API worker).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Container resource limits. Raise these only with measured headroom.
DB_MEM_LIMIT=1g
DB_CPUS=2
REDIS_MEM_LIMIT=320m
REDIS_CPUS=1
MIGRATE_MEM_LIMIT=512m
MIGRATE_CPUS=1
API_MEM_LIMIT=512m
API_CPUS=1.5
WEB_MEM_LIMIT=256m
WEB_CPUS=1

# Local development bootstrap admin, created on the first `migrate` run.
# Change this password before exposing the stack; staging/production reject a
# non-empty bootstrap password entirely.
BOOTSTRAP_ADMIN_EMAIL=admin@crewww.example.com
BOOTSTRAP_ADMIN_PASSWORD=CrewwwOwner!2026

# Current integrations are intentionally safe local adapters; these are not live providers.
# Storage uses bundled static files. The Docker Compose file overrides APP_ENV, DEBUG,
# COOKIE_SECURE, PAYMENT_MODE and EMAIL_MODE to the local container-safe values above.
