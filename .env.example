# Local development only. Replace values before using a shared environment.
# Use letters and numbers in database credentials so the DATABASE_URL stays valid.
WEB_PORT=8080
VITE_INITIAL_ROUTE=/drops/psychedelic-minds
APP_NAME=Crewww API
APP_ENV=docker
DEBUG=false
POSTGRES_DB=crewww
POSTGRES_USER=crewww
POSTGRES_PASSWORD=local-only-change-me-123456
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
JWT_SECRET=local-compose-secret-change-this-before-any-shared-environment-123456
FRONTEND_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PAYMENT_MODE=mock
EMAIL_MODE=console

# Optional one-time bootstrap admin. Delete BOOTSTRAP_ADMIN_PASSWORD after first startup;
# staging/production settings reject it. Leave both blank to create admin through a secure process.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Current integrations are intentionally safe local adapters; these are not live providers.
# Storage uses bundled static files. The Docker Compose file overrides APP_ENV, DEBUG,
# COOKIE_SECURE, PAYMENT_MODE and EMAIL_MODE to the local container-safe values above.

