# Production environment template. Copy to .env.production on the host (never commit it).
# Load with: docker compose --env-file .env.production up -d --build
APP_ENV=production
DEBUG=false
WEB_PORT=8080
VITE_INITIAL_ROUTE=/

# Public origin served by the TLS reverse proxy.
FRONTEND_ORIGINS=https://crewww.example.com
COOKIE_SECURE=true
REDIS_REQUIRED=true

VITE_FEATURE_RECENTLY_VIEWED=true
VITE_FEATURE_COMMAND_PALETTE=true
VITE_FEATURE_AMBIENT_SOUND=true
VITE_FEATURE_WORLD_WALK=true

APP_NAME=Crewww API
POSTGRES_DB=crewww
POSTGRES_USER=crewww
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional: use an existing PostgreSQL server instead of the bundled `db`.
# DATABASE_URL=postgresql+asyncpg://crewww:password@postgres.internal:5432/crewww
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-openssl-rand-hex-32-output-min-40-chars

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Keep mock/console until a real provider adapter is implemented; production
# config validation only accepts the adapters shipped in the codebase.
PAYMENT_MODE=mock
EMAIL_MODE=console

DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_MAX_CONNECTIONS=100
# Tune to roughly 25% of container memory (DB_MEM_LIMIT).
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_SLOW_QUERY_MS=250
REDIS_MAXMEMORY=512mb

DB_MEM_LIMIT=2g
DB_CPUS=2
REDIS_MEM_LIMIT=512m
REDIS_CPUS=1
MIGRATE_MEM_LIMIT=512m
MIGRATE_CPUS=1
API_MEM_LIMIT=768m
API_CPUS=2
WEB_MEM_LIMIT=256m
WEB_CPUS=1
