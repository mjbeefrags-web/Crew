# Staging environment template. Copy to .env.staging on the host (never commit it).
# Load with: docker compose --env-file .env.staging up -d --build
APP_ENV=staging
DEBUG=false
WEB_PORT=8080
WEB_HOST=127.0.0.1
VITE_INITIAL_ROUTE=/

# Replace with the real staging host before deploying.
FRONTEND_ORIGINS=https://staging.example.com
COOKIE_SECURE=true
REDIS_REQUIRED=true

# Feature flags baked into the web build.
VITE_FEATURE_RECENTLY_VIEWED=true
VITE_FEATURE_COMMAND_PALETTE=true
VITE_FEATURE_AMBIENT_SOUND=true
VITE_FEATURE_WORLD_WALK=true

APP_NAME=Crewww API
POSTGRES_DB=crewww
POSTGRES_USER=crewww
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Loopback-only host port for DB tools; keep it closed at the firewall.
POSTGRES_PORT=5433
# Optional: use an existing PostgreSQL server instead of the bundled `db`.
# DATABASE_URL=postgresql+asyncpg://crewww:password@postgres.internal:5432/crewww
REDIS_URL=redis://redis:6379/0
# Must be unique, random, 40+ characters.
JWT_SECRET=replace-with-openssl-rand-hex-32-output-min-40-chars

# Optional one-time admin bootstrap. Staging rejects a non-empty password in config,
# so keep it blank once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

PAYMENT_MODE=mock
EMAIL_MODE=console

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_SLOW_QUERY_MS=250
REDIS_MAXMEMORY=256mb

DB_MEM_LIMIT=1g
DB_CPUS=2
REDIS_MEM_LIMIT=320m
REDIS_CPUS=1
MIGRATE_MEM_LIMIT=512m
MIGRATE_CPUS=1
API_MEM_LIMIT=512m
API_CPUS=1.5
WEB_MEM_LIMIT=256m
WEB_CPUS=1
